-- Rebirth module (economy kit) client -> server messages (Blink IDL, compiled with `tools/net`).
-- core-v1.3.1 R19: the module's own net.blink (module-api.md §1, §9); the event backs the server
-- part's action of the same (PascalCase) name. Was the framework.blink event RequestRebirth.
-- The server part still validates the request (Blink checks wire types only).

option RemoteScope = "STUDWORK_REBIRTH"
option Casing = Pascal
option ServerOutput = "server/Net.luau"
option ClientOutput = "client/Net.luau"

-- Rebirth (no data; the server checks cost and max).
event Rebirth {
    From: Client,
    Type: Reliable,
    Call: SingleAsync
}
