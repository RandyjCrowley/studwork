--!strict
local Math = require(game:GetService("ReplicatedStorage").Modules.Companions.shared.FollowMath)
describe("Companion motion", function()
	it("forms deterministic behind and side rows", function()
		expect(Math.formation(1, 6, 3, 4).Z).toBe(4)
		expect(Math.formation(2, 6, 3, 4).X).toBe(-3)
		expect(Math.formation(3, 6, 3, 4).X).toBe(3)
		expect(Math.formation(4, 6, 3, 4).Z).toBe(7)
	end)
	it("uses elapsed time even at one hertz and bounds hitches", function()
		expect(math.abs(Math.alpha(1, 2) - (1 - math.exp(-2))) < 1e-8).toBe(true)
		expect(Math.alpha(99, 2)).toBe(Math.alpha(5, 2))
		expect(Math.snap(Vector3.new(0, 0, 0), Vector3.new(0, 0, 61), 60)).toBe(true)
	end)
	it("handles off center pivots and distance rates", function()
		expect(Math.ground(10, 3, 4)).toBe(9)
		local config = { nearDistance = 50, nearHz = 30, farHz = 1, lowDetailHz = 10 }
		expect(Math.rate(25, config, false)).toBe(30)
		expect(Math.rate(100, config, false)).toBe(1)
		expect(Math.rate(25, config, true)).toBe(10)
	end)
	it("respects custom idle threshold and disables every animation offset", function()
		for _, movement in { "walk", "hop", "fly", "hover" } do
			expect(Math.motion(movement, 0.25, 10, 2, true, false, 1, 1, 2).Y).toBe(0)
			expect(Math.motion(movement, 0.25, 10, 2, false, true, 1, 1, 2).Y).toBe(0)
			expect(Math.motion(movement, 0.25, 1, 2, false, false, 1, 1, 2).Y).toBe(1)
		end
		expect(Math.motion("hop", 0.75, 3, 2, false, false, 1, 1, 2).Y).toBe(0)
		expect(Math.motion("hop", 0.25, 3, 2, false, false, 1, 1, 2).Y).toBe(2)
	end)
end)
