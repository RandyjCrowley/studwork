-- Rarity module network contract (Blink IDL, compiled with `tools/net`; module-api.md §1, §9).
-- core-v1.3.1 (R19): moved out of framework.blink (was RequestRoll). Backs the server part's
-- `actions.roll` (rate 4/s, burst 8); the client part fires it via StudWork.use(Rarity).actions.roll.
-- Blink checks the wire types on receive; the handler still checks the table, cost and capacity.

option RemoteScope = "STUDWORK_RARITY"
option Casing = Pascal
option ServerOutput = "server/Net.luau"
option ClientOutput = "client/Net.luau"

type Id = string(1..64)

-- Roll a rarity table that has an in-game currency cost. (tableId)
-- Robux rolls never use this: they go through a developer product + Shop.onProduct.
event Roll {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: Id
}
