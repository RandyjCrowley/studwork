--[[
	v1.7.0 foundation: the sim's in-memory ordered stores and sorted maps (sim/MemoryStores.luau) are
	the World's, shared by every sim server and on the World's clock. (The stores builder adds
	the cross-server limit, census and failure specs in StoresCrossServer.spec.luau.)
]]

local F = require(script.Parent.Fixtures)

describe("sim ordered stores and sorted maps", function()
	it("two servers share one sorted map and one ordered store", function()
		local world = F.world()
		local a = F.server(world)
		local b = F.server(world)
		local mapA = a.runtime.sortedMapStore.forModule("Probe")("m")
		local mapB = b.runtime.sortedMapStore.forModule("Probe")("m")
		expect(mapA.set("k", { n = 1 }, 60, 5)).toBe(true)
		local ok, value, sortKey = mapB.get("k")
		expect(ok).toBe(true)
		expect(value.n).toBe(1)
		expect(sortKey).toBe(5)
		local boardA = a.runtime.orderedStore.forModule("Probe")("o")
		local boardB = b.runtime.orderedStore.forModule("Probe")("o")
		expect(boardA.set("7", 11)).toBe(true)
		local _, v = boardB.get("7")
		expect(v).toBe(11)
		expect(world.memoryStores.sortedMapNames()).toEqual({ "SW/Probe/m" })
	end)

	it("expiry follows world:advance", function()
		local world = F.world()
		local server = F.server(world)
		local map = server.runtime.sortedMapStore.forModule("Probe")("m")
		map.set("k", 1, 30)
		world:advance(31)
		local _, value = map.get("k")
		expect(value).toBe(nil)
	end)

	it("a sim server without a services fake refuses the service, naming the fix", function()
		local world = F.world()
		local server = F.server(world)
		local api = server.runtime.services.forModule("Probe")
		local ok, err = pcall(function()
			api.get("BadgeService"):AwardBadgeAsync(1, 2)
		end)
		expect(ok).toBe(false)
		expect(string.find(tostring(err), "no test fake for BadgeService", 1, true) ~= nil).toBe(true)
	end)
end)
