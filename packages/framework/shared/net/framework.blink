-- StudWork framework network contract (Blink IDL, compiled with `tools/net` -> blink 0.18.9).
-- Only the framework's OWN messages live here: state sync, feedback, live events, admin triggers
-- and UI funnel steps. v1.3.1 (R19): no module has events here; every module (kits included)
-- declares its actions/events in its own <Module>/net.blink with its own RemoteScope
-- (module-api.md §1, §9, §19.9). The `special` guardrail fails on any kit name in this file.
-- Every client -> server event is a REQUEST: the server validates type, range and ownership
-- and rate-limits it in packages/framework/server/Net before any handler sees it. Blink checks
-- the wire types/ranges below on receive; handlers still check ownership and rules.

option RemoteScope = "STUDWORK"
option Casing = Pascal
option ServerOutput = "../../server/Net/Generated.luau"
option ClientOutput = "../../client/Net/Generated.luau"
option TypesOutput = "Generated.Types.luau"

type Id = string(1..64)

-- ===== client -> server requests =====

-- Ask for a full state snapshot (sent once when the client boots).
event StateInit {
    From: Client,
    Type: Reliable,
    Call: SingleAsync
}

-- Admin-only: trigger a configured event now. Server checks ServerConfig.admins (Core.start's
-- server-only second argument; Studio allows everyone). (eventId)
event AdminTriggerEvent {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: Id
}

-- UI-only funnel step; accepted only if listed in AnalyticsConfig.clientSteps. (step)
event ClientFunnel {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: string(1..32)
}

-- ===== server -> client =====

-- Replicated state for the local player only (charm-sync payload, or a full snapshot).
event StateSync {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: unknown
}

-- Cosmetic feedback: number pops, tier reveals, toasts. Tier: a theme tier id (v1.3.1:
-- was `Rarity`; the framework wire names no kit).
struct FeedbackMessage {
    Kind: string(1..32),
    Text: string(0..120),
    Tier: string(1..16)?,
    Position: vector?
}

event Feedback {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: FeedbackMessage
}

-- A live event started (endsAt > 0) or ended (endsAt == 0). (eventId, endsAt unix seconds)
event EventState {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: (Id, f64)
}
