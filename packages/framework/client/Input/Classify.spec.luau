local Classify = require(script.Parent.Classify)

describe("Input.Classify", function()
	it("maps Enum.PreferredInput names", function()
		expect(Classify.fromPreferredInput("KeyboardAndMouse")).toBe("KeyboardMouse")
		expect(Classify.fromPreferredInput("Gamepad")).toBe("Gamepad")
		expect(Classify.fromPreferredInput("MicroGamepad")).toBe("Gamepad")
		expect(Classify.fromPreferredInput("Touch")).toBe("Touch")
		expect(Classify.fromPreferredInput("Other")).toBeNil()
	end)
	it("maps Enum.UserInputType names", function()
		expect(Classify.fromInputType("Touch")).toBe("Touch")
		expect(Classify.fromInputType("Gamepad1")).toBe("Gamepad")
		expect(Classify.fromInputType("Gamepad8")).toBe("Gamepad")
		expect(Classify.fromInputType("Keyboard")).toBe("KeyboardMouse")
		expect(Classify.fromInputType("MouseButton1")).toBe("KeyboardMouse")
		expect(Classify.fromInputType("MouseWheel")).toBe("KeyboardMouse")
		expect(Classify.fromInputType("Focus")).toBeNil()
		expect(Classify.fromInputType("Accelerometer")).toBeNil()
	end)
	it("falls back to capabilities", function()
		expect(Classify.fromCapabilities(true, false, false)).toBe("Touch")
		expect(Classify.fromCapabilities(false, false, true)).toBe("Gamepad")
		expect(Classify.fromCapabilities(true, true, true)).toBe("KeyboardMouse")
	end)
end)
