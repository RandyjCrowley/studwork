local PopAnim = require(script.Parent.PopAnim)

describe("Feedback.PopAnim", function()
	it("squashes then stretches then settles", function()
		local squash = PopAnim.sample(0.079)
		expect(squash.sx).toBeGreaterThan(squash.sy)
		local stretch = PopAnim.sample(0.199)
		expect(stretch.sy).toBeGreaterThan(stretch.sx)
		local settled = PopAnim.sample(0.5)
		expect(settled.sx).toBe(1)
		expect(settled.sy).toBe(1)
		expect(settled.alpha).toBe(0)
	end)
	it("rises over time and fades out at the end", function()
		expect(PopAnim.sample(0.6).rise).toBeGreaterThan(PopAnim.sample(0.3).rise)
		expect(PopAnim.sample(PopAnim.DURATION - 0.01).alpha).toBeGreaterThan(0.9)
		local done = PopAnim.sample(PopAnim.DURATION + 1)
		expect(done.alpha).toBe(1)
	end)
	it("reduced motion keeps scale 1 and no rise", function()
		for _, t in { 0.05, 0.15, 0.5, 1.0 } do
			local s = PopAnim.sample(t, true)
			expect(s.sx).toBe(1)
			expect(s.sy).toBe(1)
			expect(s.rise).toBe(0)
		end
	end)
	it("picks the lowest free slot and wraps when full", function()
		expect(PopAnim.freeSlot({}, 3)).toBe(0)
		expect(PopAnim.freeSlot({ [0] = true, [1] = true }, 3)).toBe(2)
		expect(PopAnim.freeSlot({ [0] = true, [1] = true, [2] = true }, 3)).toBe(0)
		expect(PopAnim.stackOffset(2)).toBe(-2 * PopAnim.SLOT_HEIGHT)
	end)
end)
