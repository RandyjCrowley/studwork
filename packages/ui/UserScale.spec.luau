local UserScale = require(script.Parent.UserScale)
describe("local root scale", function()
	it("composes bounded preference and responsive scale without accepting invalid attributes", function()
		expect(UserScale.combined(0.85, 0.8)).toBe(0.68)
		expect(UserScale.preference(0 / 0)).toBe(1)
		expect(UserScale.preference(5)).toBe(1)
		expect(UserScale.preference("1")).toBe(1)
	end)
end)
