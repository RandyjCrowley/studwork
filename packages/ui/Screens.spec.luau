local Screens = require(script.Parent.Screens)

local function A() end
local function B() end

describe("Screens registry", function()
	it("registers, opens and closes a screen", function()
		local reg = Screens.new()
		local calls = 0
		reg:subscribe(function()
			calls += 1
		end)
		reg:register("Shop", A)
		expect(reg:get("Shop")).toBe(A)
		reg:open("Shop", { tab = 2 })
		expect(reg:isOpen("Shop")).toBe(true)
		local list = reg:openList()
		expect(#list).toBe(1)
		expect(list[1].component).toBe(A)
		expect(list[1].props.tab).toBe(2)
		reg:close("Shop")
		expect(reg:isOpen("Shop")).toBe(false)
		expect(calls).toBe(3)
	end)

	it("replaces a screen registered under the same name, even while open", function()
		local reg = Screens.new()
		reg:register("Odds", A)
		reg:open("Odds")
		reg:register("Odds", B)
		expect(reg:get("Odds")).toBe(B)
		expect(reg:openList()[1].component).toBe(B)
		expect(reg:names()).toEqual({ "Odds" })
	end)

	it("keeps open order (re-opening moves it on top) and errors on unknown names", function()
		local reg = Screens.new()
		reg:register("A", A)
		reg:register("B", B)
		reg:open("A")
		reg:open("B")
		reg:open("A", { x = 1 })
		local list = reg:openList()
		expect(list[1].name).toBe("B")
		expect(list[2].name).toBe("A")
		expect(list[2].props.x).toBe(1)
		expect(function()
			reg:open("Missing")
		end).toThrow("no screen 'Missing'")
		expect(function()
			reg:register("Bad", 5)
		end).toThrow("must be a React component")
	end)
end)
