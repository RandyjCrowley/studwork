--!nocheck
--!nolint DeprecatedApi
local fs = (getmetatable(getfenv(1)) :: any).__index.require("@lune/fs")
local source = fs.readFile("packages/ui/WrappedText.luau")
local ui = fs.readFile("packages/ui/init.luau")
describe("UI.WrappedText measured multiline", function()
	it("exports a measured component instead of automatic Y sizing", function()
		expect(ui).toContain("UI.WrappedText = require(script.WrappedText)")
		expect(source).toContain("TextService:GetTextBoundsAsync(params)")
		expect(source).toContain('GetPropertyChangedSignal("AbsoluteSize")')
		expect(source).toContain("ancestorScale *= child.Scale")
		expect(source).toContain("width - 2 * pad")
		expect(source).never.toContain("AutomaticSize = Enum.AutomaticSize.Y")
	end)
	it("uses a nonzero fallback when measurement fails", function()
		expect(source).toContain("pcall(function()")
		expect(source).toContain("math.max(size + 2 * pad")
		expect(source).toContain("setHeight(fallback)")
	end)
end)
