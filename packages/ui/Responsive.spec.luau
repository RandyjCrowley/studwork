local Responsive = require(script.Parent.Responsive)

describe("Responsive", function()
	it("scales from the short side and clamps", function()
		expect(Responsive.scale(640, 300)).toBe(Responsive.MIN_SCALE)
		expect(Responsive.scale(844, 390)).toBeNear(0.975, 1e-9)
		expect(Responsive.scale(1920, 1080)).toBe(1.75)
		expect(Responsive.scale(1024, 600)).toBeNear(1.5, 1e-9)
		expect(Responsive.scale(0, 0)).toBe(1)
	end)
	it("keeps touch targets at least minPx after the smallest scale", function()
		local t = Responsive.touchTarget(44)
		expect(t * Responsive.MIN_SCALE).toBeGreaterThanOrEqual(44)
	end)
end)
