local Format = require(script.Parent.Format)

describe("Format.abbreviate", function()
	it("keeps small numbers", function()
		expect(Format.abbreviate(0)).toBe("0")
		expect(Format.abbreviate(7)).toBe("7")
		expect(Format.abbreviate(999)).toBe("999")
		expect(Format.abbreviate(0.5)).toBe("0.5")
		expect(Format.abbreviate(12.34)).toBe("12.3")
		expect(Format.abbreviate(150.7)).toBe("150")
	end)
	it("abbreviates with suffixes", function()
		expect(Format.abbreviate(1000)).toBe("1K")
		expect(Format.abbreviate(1234)).toBe("1.2K")
		expect(Format.abbreviate(3_400_000)).toBe("3.4M")
		expect(Format.abbreviate(5.6e9)).toBe("5.6B")
		expect(Format.abbreviate(7.25e12)).toBe("7.2T")
		expect(Format.abbreviate(1e15)).toBe("1Qa")
	end)
	it("truncates instead of rounding into the next suffix", function()
		expect(Format.abbreviate(999_999)).toBe("999.9K")
		expect(Format.abbreviate(1999)).toBe("1.9K")
	end)
	it("handles sign, decimals and edge values", function()
		expect(Format.abbreviate(-2500)).toBe("-2.5K")
		expect(Format.abbreviate(1234567, 2)).toBe("1.23M")
		expect(Format.abbreviate(0 / 0)).toBe("0")
		expect(Format.abbreviate(math.huge)).toBe("inf")
		expect(Format.abbreviate(1e40)).toContain("e")
	end)
end)

describe("Format.percent", function()
	it("formats ordinary chances", function()
		expect(Format.percent(0.5)).toBe("50%")
		expect(Format.percent(0.125)).toBe("12.5%")
		expect(Format.percent(1 / 3)).toBe("33.33%")
		expect(Format.percent(1)).toBe("100%")
		expect(Format.percent(0)).toBe("0%")
	end)
	it("never shows 0% for a non-zero chance", function()
		expect(Format.percent(0.00001)).toBe("0.001%")
		expect(Format.percent(0.0000123)).toBe("0.0012%")
		expect(Format.percent(0.00004999)).toBe("0.005%")
		for _, p in { 1e-3, 1e-5, 1e-7, 1e-9, 1e-11, 1e-13, 1e-20 } do
			local s = Format.percent(p)
			expect(s ~= "0%" and string.match(s, "^0%.?0*%%$") == nil).toBe(true)
		end
		expect(Format.percent(1e-20)).toContain("<")
	end)
	it("never shows 100% for a chance below 1", function()
		expect(Format.percent(0.99999)).toBe("99.99%")
	end)
end)
