local ToastQueue = require(script.Parent.ToastQueue)

describe("ToastQueue", function()
	it("shows up to maxVisible and queues the rest", function()
		local q = ToastQueue.new({ maxVisible = 2, duration = 1 })
		ToastQueue.push(q, "a", 0)
		ToastQueue.push(q, "b", 0)
		ToastQueue.push(q, "c", 0)
		expect(#q.visible).toBe(2)
		expect(#q.pending).toBe(1)
	end)
	it("auto-dismisses and promotes pending toasts", function()
		local q = ToastQueue.new({ maxVisible = 1, duration = 2 })
		ToastQueue.push(q, "a", 0)
		ToastQueue.push(q, "b", 0)
		expect(ToastQueue.nextDeadline(q)).toBe(2)
		expect(ToastQueue.tick(q, 1)).toBe(false)
		expect(ToastQueue.tick(q, 2)).toBe(true)
		expect(q.visible[1].text).toBe("b")
		expect(q.visible[1].expiresAt).toBe(4)
		ToastQueue.tick(q, 4)
		expect(#q.visible).toBe(0)
		expect(ToastQueue.nextDeadline(q)).toBeNil()
	end)
	it("merges duplicates and restarts the timer", function()
		local q = ToastQueue.new({ duration = 3 })
		local id1 = ToastQueue.push(q, "streak", 0)
		local id2 = ToastQueue.push(q, "streak", 2)
		expect(id1).toBe(id2)
		expect(#q.visible).toBe(1)
		expect(q.visible[1].count).toBe(2)
		expect(q.visible[1].expiresAt).toBe(5)
	end)
	it("dismisses by id and caps pending", function()
		local q = ToastQueue.new({ maxVisible = 1, maxPending = 2 })
		local a = ToastQueue.push(q, "a", 0)
		ToastQueue.push(q, "b", 0)
		ToastQueue.push(q, "c", 0)
		ToastQueue.push(q, "d", 0)
		expect(#q.pending).toBe(2)
		expect(q.pending[1].text).toBe("c")
		expect(ToastQueue.dismiss(q, a, 1)).toBe(true)
		expect(q.visible[1].text).toBe("c")
		expect(ToastQueue.dismiss(q, 999, 1)).toBe(false)
	end)
end)
