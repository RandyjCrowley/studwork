local PlotLayout = require(script.Parent)

local function ids(list: { any }): number
	return #list
end

describe("PlotLayout.dimensions", function()
	it("defaults to a near-square grid", function()
		expect({ PlotLayout.dimensions(8) }).toEqual({ 3, 3 })
		expect({ PlotLayout.dimensions(9) }).toEqual({ 3, 3 })
		expect({ PlotLayout.dimensions(1) }).toEqual({ 1, 1 })
	end)
	it("honours cols and rows", function()
		expect({ PlotLayout.dimensions(8, { cols = 4 }) }).toEqual({ 4, 2 })
		expect({ PlotLayout.dimensions(8, { rows = 4 }) }).toEqual({ 2, 4 })
		expect({ PlotLayout.dimensions(3, { cols = 10 }) }).toEqual({ 3, 1 })
	end)
	it("returns 0,0 for invalid counts", function()
		expect({ PlotLayout.dimensions(0) }).toEqual({ 0, 0 })
		expect({ PlotLayout.dimensions(0 / 0) }).toEqual({ 0, 0 })
		expect({ PlotLayout.dimensions(-3) }).toEqual({ 0, 0 })
	end)
end)

describe("PlotLayout.grid", function()
	it("is backwards compatible with grid(count, spacing)", function()
		local o = PlotLayout.grid(4, 10)
		expect(ids(o)).toBe(4)
		expect(o[1]).toEqual({ x = -5, z = -5 })
		expect(o[2]).toEqual({ x = 5, z = -5 })
		expect(o[3]).toEqual({ x = -5, z = 5 })
		expect(o[4]).toEqual({ x = 5, z = 5 })
	end)
	it("matches the sandbox 4x2 pad layout", function()
		local o = PlotLayout.grid(8, { cols = 4, spacingX = 8, spacingZ = 10 })
		expect(o[1]).toEqual({ x = -12, z = -5 })
		expect(o[4]).toEqual({ x = 12, z = -5 })
		expect(o[5]).toEqual({ x = -12, z = 5 })
		expect(o[8]).toEqual({ x = 12, z = 5 })
	end)
	it("is centred (offsets sum to ~0 for full grids)", function()
		local sx, sz = 0, 0
		for _, o in PlotLayout.grid(12, { cols = 4, spacing = 3 }) do
			sx += o.x
			sz += o.z
		end
		expect(sx).toBeNear(0)
		expect(sz).toBeNear(0)
	end)
	it("falls back to default spacing on bad input and returns nothing for bad counts", function()
		local o = PlotLayout.grid(2, { spacing = -1 })
		expect(o[2].x - o[1].x).toBe(8)
		expect(ids(PlotLayout.grid(0, 5))).toBe(0)
		expect(ids(PlotLayout.grid(0 / 0))).toBe(0)
		expect(ids(PlotLayout.grid(3.9))).toBe(3)
	end)
end)

describe("PlotLayout.ring", function()
	it("places slots evenly on the circle", function()
		local r = PlotLayout.ring(4, 10)
		expect(ids(r)).toBe(4)
		expect(r[1].x).toBeNear(10)
		expect(r[1].z).toBeNear(0)
		expect(r[2].x).toBeNear(0)
		expect(r[2].z).toBeNear(10)
		expect(r[3].x).toBeNear(-10)
		for _, p in r do
			expect(math.sqrt(p.x * p.x + p.z * p.z)).toBeNear(10)
		end
	end)
	it("yaw points the pad front (-Z) at the centre", function()
		for _, p in PlotLayout.ring(7, 12, 0.3) do
			local fx, fz = -math.sin(p.yaw), -math.cos(p.yaw)
			expect(fx).toBeNear(-p.x / 12, 1e-9)
			expect(fz).toBeNear(-p.z / 12, 1e-9)
		end
	end)
	it("handles start angle and invalid input", function()
		local r = PlotLayout.ring(1, 5, math.pi / 2)
		expect(r[1].x).toBeNear(0)
		expect(r[1].z).toBeNear(5)
		expect(ids(PlotLayout.ring(0, 5))).toBe(0)
		expect(PlotLayout.ring(2, -5)[1].x).toBeNear(0)
	end)
end)

describe("PlotLayout.gridSize / slotId", function()
	it("computes the footprint", function()
		expect({ PlotLayout.gridSize(8, { cols = 4, spacingX = 8, spacingZ = 10 }, 3) }).toEqual({ 30, 16 })
		expect({ PlotLayout.gridSize(0, nil, 2) }).toEqual({ 4, 4 })
	end)
	it("formats slot ids", function()
		expect(PlotLayout.slotId(1)).toBe("slot01")
		expect(PlotLayout.slotId(12)).toBe("slot12")
		expect(PlotLayout.slotId(0 / 0)).toBe("slot00")
	end)
end)
