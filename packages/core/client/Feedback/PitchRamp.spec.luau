local PitchRamp = require(script.Parent.PitchRamp)

describe("Feedback.PitchRamp", function()
	it("rises on rapid ticks, caps, and resets after a pause", function()
		local ramp = PitchRamp.new({ base = 1, step = 0.1, max = 1.25, window = 0.3 })
		expect(ramp:next(0)).toBe(1)
		expect(ramp:next(0.1)).toBeNear(1.1, 1e-9)
		expect(ramp:next(0.2)).toBeNear(1.2, 1e-9)
		expect(ramp:next(0.3)).toBeNear(1.25, 1e-9)
		expect(ramp:next(0.4)).toBeNear(1.25, 1e-9)
		expect(ramp:next(1.0)).toBe(1)
	end)
	it("resets on a clock going backwards and on reset()", function()
		local ramp = PitchRamp.new()
		ramp:next(5)
		ramp:next(5.1)
		expect(ramp:next(1)).toBe(1)
		ramp:next(1.1)
		ramp:reset()
		expect(ramp:next(1.2)).toBe(1)
	end)
end)
