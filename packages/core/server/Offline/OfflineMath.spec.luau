local OfflineMath = require(script.Parent.OfflineMath)

local cfg = { capSeconds = 3600, minSeconds = 60, payoutFraction = 0.5, autoPay = true }

describe("OfflineMath.secondsAway", function()
	it("returns time away for returning players", function()
		expect(OfflineMath.secondsAway(10000, 9000, 2, cfg)).toBe(1000)
	end)
	it("caps at capSeconds", function()
		expect(OfflineMath.secondsAway(100000, 1000, 5, cfg)).toBe(3600)
	end)
	it("skips below minSeconds (boundary counts)", function()
		expect(OfflineMath.secondsAway(10059, 10000, 2, cfg)).toBeNil()
		expect(OfflineMath.secondsAway(10060, 10000, 2, cfg)).toBe(60)
	end)
	it("treats clock skew (lastSeen in the future) as 0 -> skipped", function()
		expect(OfflineMath.secondsAway(10000, 20000, 2, cfg)).toBeNil()
	end)
	it("skips first sessions and missing lastSeen", function()
		expect(OfflineMath.secondsAway(10000, 1000, 1, cfg)).toBeNil()
		expect(OfflineMath.secondsAway(10000, 0, 3, cfg)).toBeNil()
		expect(OfflineMath.secondsAway(10000, 0 / 0, 3, cfg)).toBeNil()
	end)
	it("with minSeconds 0 still ignores zero time", function()
		local c = { capSeconds = 10, minSeconds = 0, payoutFraction = 1, autoPay = true }
		expect(OfflineMath.secondsAway(5, 5, 2, c)).toBeNil()
		expect(OfflineMath.secondsAway(6, 5, 2, c)).toBe(1)
	end)
end)

describe("OfflineMath.payout", function()
	it("is floor(rate * seconds * fraction)", function()
		expect(OfflineMath.payout(3, 1000, 0.5)).toBe(1500)
		expect(OfflineMath.payout(1.3, 7, 0.5)).toBe(4) -- 4.55
	end)
	it("clamps the fraction to 0..1", function()
		expect(OfflineMath.payout(2, 10, 5)).toBe(20)
		expect(OfflineMath.payout(2, 10, -1)).toBe(0)
	end)
	it("returns 0 for bad input", function()
		expect(OfflineMath.payout(0, 10, 1)).toBe(0)
		expect(OfflineMath.payout(0 / 0, 10, 1)).toBe(0)
		expect(OfflineMath.payout(math.huge, 10, 1)).toBe(0)
	end)
end)
