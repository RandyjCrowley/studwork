local PendingQueue = require(script.Parent.PendingQueue)

describe("Net.PendingQueue", function()
	it("keeps requests in order with their args", function()
		local q = PendingQueue.new(4, function() end)
		expect(q:push("RequestRoll", "p1", "Chest")).toBe(true)
		expect(q:push("RequestDisplay", "p2", "uid", nil)).toBe(true)
		expect(q:size()).toBe(2)
		local items = q:drain()
		expect(#items).toBe(2)
		expect(items[1].eventName).toBe("RequestRoll")
		expect(items[1].args[1]).toBe("Chest")
		expect(items[2].player).toBe("p2")
		expect(items[2].args.n).toBe(2)
		expect(q:size()).toBe(0)
	end)

	it("drops past the cap and calls onFull once", function()
		local calls = 0
		local q = PendingQueue.new(2, function(cap)
			calls += 1
			expect(cap).toBe(2)
		end)
		expect(q:push("a", 1)).toBe(true)
		expect(q:push("a", 2)).toBe(true)
		expect(q:push("a", 3)).toBe(false)
		expect(q:push("a", 4)).toBe(false)
		expect(calls).toBe(1)
		expect(q.dropped).toBe(2)
		expect(q:size()).toBe(2)
	end)

	it("cap 0 drops everything", function()
		local q = PendingQueue.new(0, function() end)
		expect(q:push("a", 1)).toBe(false)
	end)
end)
