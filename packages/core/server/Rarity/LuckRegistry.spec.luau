local LuckRegistry = require(script.Parent.LuckRegistry)
local RollMath = require(script.Parent.RollMath)

describe("LuckRegistry", function()
	it("defaults to 1 and stores sanitised values", function()
		local r = LuckRegistry.new(RollMath.sanitizeLuck)
		local p = {}
		expect(r:get(p)).toBe(1)
		expect(r:get(p, "Egg")).toBe(1)
		expect(r:has(p)).toBe(false)
		r:set(p, 0 / 0)
		expect(r:get(p)).toBe(1)
		r:set(p, -2, "Egg")
		expect(r:get(p, "Egg")).toBe(1)
		r:set(p, 1e9)
		expect(r:get(p, "Other")).toBe(RollMath.MAX_LUCK)
		expect(r:has(p)).toBe(true)
	end)

	it("per-table luck wins over the all-table value (even a per-table 1)", function()
		local r = LuckRegistry.new(RollMath.sanitizeLuck)
		local p = {}
		r:set(p, 2)
		r:set(p, 1.5, "Egg")
		r:set(p, 1, "Box")
		expect(r:get(p, "Egg")).toBe(1.5)
		expect(r:get(p, "Box")).toBe(1)
		expect(r:get(p, "Other")).toBe(2)
		expect(r:get(p)).toBe(2)
	end)

	it("keeps players apart and clear() forgets one player", function()
		local r = LuckRegistry.new(RollMath.sanitizeLuck)
		local a, b = {}, {}
		r:set(a, 3)
		r:set(b, 2, "Egg")
		r:clear(a)
		expect(r:get(a)).toBe(1)
		expect(r:has(a)).toBe(false)
		expect(r:get(b, "Egg")).toBe(2)
	end)
end)
