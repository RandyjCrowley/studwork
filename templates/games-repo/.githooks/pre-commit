#!/usr/bin/env bash
# .githooks/pre-commit (games repo): lint (incl. the framework pin) + the games' tests before every
# commit. Enabled by tools/install (git config core.hooksPath .githooks). bash 3.2 compatible.
# v1.4.1: git runs hooks with GIT_INDEX_FILE (relative) etc. set; roblox-core/tools/_common.sh
# keeps them for this repo's staged-file checks (normal and partial commits) and clears them for
# the `git -C roblox-core` pin check (v1.4.0 blocked every commit with "not a git checkout").
set -u
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
LOG="$(mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX")"
trap 'rm -f "$LOG"' EXIT
step() {
	local label="$1"
	shift
	printf 'pre-commit: %-6s ... ' "$label"
	if "$@" >"$LOG" 2>&1; then
		echo "ok ($(tail -1 "$LOG"))"
		return 0
	fi
	echo "FAILED"
	cat "$LOG"
	echo "pre-commit: commit blocked by '$label'. Fix it (run: $*)."
	exit 1
}
step lint tools/lint
step tests tools/test
