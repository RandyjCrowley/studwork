#!/usr/bin/env bash
# tools/_studwork <core-tool> [args...]: run roblox-core/tools/<core-tool> with this games repo as
# the project root (StudWork v1.4.0, roblox-core/docs/framework/games-repo.md). Every other file in
# tools/ is a one-line wrapper around this one. Copied from roblox-core/templates/games-repo/.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CORE="$ROOT/roblox-core"
TOOL="${1:-}"
[ -n "$TOOL" ] || {
	echo "usage: tools/_studwork <core-tool> [args...]" >&2
	exit 1
}
shift
if [ ! -x "$CORE/tools/$TOOL" ]; then
	echo "error: $CORE/tools/$TOOL not found. Initialise the framework submodule:" >&2
	echo "  git -c protocol.file.allow=always submodule update --init" >&2
	exit 1
fi
export STUDWORK_PROJECT_ROOT="$ROOT"
exec "$CORE/tools/$TOOL" "$@"
