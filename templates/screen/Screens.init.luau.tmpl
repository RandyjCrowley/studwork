--!strict
--[[
	The game's screens (generated by tools/make-screen). Every ModuleScript in this folder is a
	React screen component, registered under its file name with UI.registerScreen (module-api.md
	§13). Main.client.luau calls registerAll() right after StudWork.start(Config). A name a module
	already registered (e.g. "Inventory") is replaced by the game's screen.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- UI.registerScreen / UI.open: the screen registry contract of module-api.md §13 (packages/ui)
local UI = require(ReplicatedStorage:WaitForChild("UI")) :: any

local Screens = {}

function Screens.registerAll()
	for _, child in script:GetChildren() do
		if child:IsA("ModuleScript") then
			UI.registerScreen(child.Name, (require :: any)(child))
		end
	end
end

return Screens
