--!strict
--[[
	{{Name}} screen (generated by tools/make-screen). Registered with UI.registerScreen("{{Name}}", ...)
	by src/client/Screens/init.luau; open it from anywhere on the client with UI.open("{{Name}}", props).
	Registering another screen named "{{Name}}" replaces it (module-api.md §13). Built from UI kit
	parts, which read the theme: no colours, fonts or sizes here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("React"))
local UI = require(ReplicatedStorage:WaitForChild("UI"))

local e = React.createElement

export type Props = {
	onClose: (() -> ())?,
}

local function {{Name}}(props: Props)
	return e(UI.Modal, {
		open = true,
		title = "{{title}}",
		onClose = props.onClose,
	}, {
		Close = e(UI.Button, {
			text = "Close",
			variant = "secondary",
			layoutOrder = 1,
			onActivated = props.onClose,
		}),
	})
end

return {{Name}}
