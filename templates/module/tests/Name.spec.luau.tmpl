--!nocheck
-- {{Name}} harness test (generated by tools/make-module; module-api.md §15). Pure Lune, no
-- Studio: tools/test {{dir}}
local StudWork = require(game:GetService("ReplicatedStorage"):WaitForChild("Framework"))
local Definition = require("{{dir}}/module.luau")
local Server = require("{{dir}}/server/init.luau")

local function boot(config: any?): any
	return StudWork.test.harness({
		modules = { Definition },
		servers = { {{Name}} = Server },
		config = config,
	})
end

describe("{{Name}}", function()
	it("boots and counts one visit per load in its own save section", function()
		local h = boot()
		local p = h:addPlayer({ userId = 1 })
		expect(h:use(Definition).visits(p)).toBe(1)
		h:rejoin(p, { secondsAway = 60 })
		expect(h:use(Definition).visits(p)).toBe(2)
	end)

	it("takes its config from GameConfig.config.{{Name}} over the defaults", function()
		local h = boot({ {{Name}} = { pointsPerVisit = 3 } })
		local p = h:addPlayer({ userId = 2 })
		expect(h:use(Definition).visits(p)).toBe(3)
	end)
end)
