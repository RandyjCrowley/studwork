--!strict
--[[
	{{Name}} server part (module-api.md §3-§9), generated by tools/make-module. Everything comes
	from ctx: its config, its own save section, its declared dependencies, the shared ticker.
	init(ctx): no yielding, no calls into other modules. start(ctx): connect events, call deps.
]]

local {{Name}} = {}

local ctx: any = nil

function {{Name}}.init(c: any)
	ctx = c
end

function {{Name}}.start(c: any)
	c.lifecycle.onPlayerLoaded(function(player: Player)
		c.data.update(player, function(section: any)
			section.visits += c.config.pointsPerVisit
		end)
	end)
end

-- The public API (StudWork.use({{Name}}) on the server, ctx.deps[{{Name}}] in dependents). Frozen.
{{Name}}.api = {
	visits = function(player: Player): number
		return ctx.data.get(player).visits
	end,
}

return {{Name}}
