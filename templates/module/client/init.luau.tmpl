--!strict
--[[
	{{Name}} client part (module-api.md §9-§10), generated by tools/make-module. StudWork.use({{Name}})
	on the client returns { actions, state, ...api }; state() is this module's replicated slice
	{ data = { visits }, extra = { ... } }.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StudWork = require(ReplicatedStorage:WaitForChild("Framework"))

local Definition = require(script.Parent:WaitForChild("module"))

local {{Name}}Client = {}

{{Name}}Client.api = {
	visits = function(): number
		local slice = StudWork.use(Definition).state()
		return if slice.data then slice.data.visits or 0 else 0
	end,
}

return {{Name}}Client
