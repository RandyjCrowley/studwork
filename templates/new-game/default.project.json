{
  "name": "_sandbox",
  "servePort": 34872,
  "globIgnorePaths": [
    "**/*.spec.luau",
    "**/README.md",
    "**/SOURCE.md",
    "**/*.blink",
    "**/LICENSE"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Packages": {
        "$path": "../../deps/Packages"
      },
      "FrameworkClient": {
        "$path": "../../packages/framework/client"
      },
      "Framework": {
        "$path": "../../packages/framework/shared"
      },
      "Kits": {
        "$className": "Folder",
        "Collection": {
          "$path": "../../packages/kits/collection/shared"
        },
        "Economy": {
          "$path": "../../packages/kits/economy/shared"
        },
        "Base": {
          "$path": "../../packages/kits/base/shared"
        },
        "Social": {
          "$path": "../../packages/kits/social/shared"
        },
        "Engagement": {
          "$path": "../../packages/kits/engagement/shared"
        }
      },
      "UI": {
        "$path": "../../packages/ui"
      },
      "Game": {
        "$path": "src/shared"
      },
      "GameModule": {
        "$className": "Folder",
        "module": {
          "$path": "modules/sandbox/module.luau"
        }
      }
    },
    "ServerScriptService": {
      "Framework": {
        "$path": "../../packages/framework/server"
      },
      "Kits": {
        "$className": "Folder",
        "Collection": {
          "$path": "../../packages/kits/collection/server"
        },
        "Economy": {
          "$path": "../../packages/kits/economy/server"
        },
        "Base": {
          "$path": "../../packages/kits/base/server"
        },
        "Social": {
          "$path": "../../packages/kits/social/server"
        },
        "Engagement": {
          "$path": "../../packages/kits/engagement/server"
        }
      },
      "Game": {
        "$path": "src/server"
      },
      "Modules": {
        "$className": "Folder",
        "Sandbox": {
          "$path": "modules/sandbox/server"
        }
      }
    },
    "ServerStorage": {
      "ServerPackages": {
        "$path": "../../deps/ServerPackages"
      },
      "Vendor": {
        "$path": "../../packages/vendor"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Game": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
