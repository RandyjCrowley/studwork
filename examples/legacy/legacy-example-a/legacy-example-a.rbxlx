    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">DataManager</string>
        <string name="Source"><![CDATA[-- DataManager: loads and saves every player's data (coins, inventory, settings).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local store = DataStoreService:GetDataStore("PlayerSave_v3")

local DEFAULT = {
	coins = 0,
	inventory = {},
	settings = { music = true, sfx = true },
	lastDaily = 0,
}

local sessions = {}
_G.PlayerData = sessions

local function copy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = if type(v) == "table" then copy(v) else v
	end
	return out
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

local function makeLeaderstats(player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = data.coins
	coins.Parent = stats
	stats.Parent = player
end

local function onJoin(player)
	local ok, saved = pcall(function()
		return store:GetAsync(keyFor(player))
	end)
	if not ok then
		player:Kick("Could not load your data, please rejoin")
		return
	end
	local data = copy(DEFAULT)
	if type(saved) == "table" then
		for k, v in pairs(saved) do
			data[k] = v
		end
	end
	sessions[player] = data
	makeLeaderstats(player, data)
end

local function save(player)
	local data = sessions[player]
	if not data then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(keyFor(player), data)
	end)
	if not ok then
		warn("save failed for", player.Name, err)
	end
end

function _G.AddCoins(player, amount)
	local data = sessions[player]
	if not data then
		return
	end
	data.coins += amount
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = data.coins
	end
end

Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(function(player)
	save(player)
	sessions[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		save(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			save(player)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">ShopServer</string>
        <string name="Source"><![CDATA[-- ShopServer: buying items with coins, the daily reward, settings, and the shop list.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ShopItems = require(ReplicatedStorage:WaitForChild("ShopItems"))

local DAILY_REWARD = 100
local DAILY_SECONDS = 24 * 60 * 60

Remotes.BuyItem.OnServerEvent:Connect(function(player, itemId)
	local data = _G.PlayerData[player]
	local item = ShopItems[itemId]
	if not data or not item then
		return
	end
	if table.find(data.inventory, itemId) then
		return
	end
	if data.coins < item.price then
		return
	end
	_G.AddCoins(player, -item.price)
	table.insert(data.inventory, itemId)
end)

Remotes.ClaimDaily.OnServerEvent:Connect(function(player)
	local data = _G.PlayerData[player]
	if not data then
		return
	end
	if os.time() - data.lastDaily < DAILY_SECONDS then
		return
	end
	data.lastDaily = os.time()
	_G.AddCoins(player, DAILY_REWARD)
end)

Remotes.ToggleMusic.OnServerEvent:Connect(function(player, on)
	local data = _G.PlayerData[player]
	if data and type(on) == "boolean" then
		data.settings.music = on
	end
end)

Remotes.GetShop.OnServerInvoke = function(player)
	local data = _G.PlayerData[player]
	return ShopItems, data and data.inventory or {}
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="10">
      <Properties>
        <string name="Name">Purchases</string>
        <string name="Source"><![CDATA[-- Purchases: developer products (Robux), the Roblox sample pattern with a purchase history store.
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local purchaseHistory = DataStoreService:GetDataStore("PurchaseHistory")

local COIN_PACK = 1234567 -- 1000 coins

local handlers = {
	[COIN_PACK] = function(player)
		_G.AddCoins(player, 1000)
		return true
	end,
}

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local playerProductKey = receiptInfo.PlayerId .. "_" .. receiptInfo.PurchaseId
	local ok, purchased = pcall(function()
		return purchaseHistory:GetAsync(playerProductKey)
	end)
	if ok and purchased then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local handler = handlers[receiptInfo.ProductId]
	if not handler then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local okGrant = pcall(handler, player)
	if not okGrant then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local okSave = pcall(function()
		purchaseHistory:SetAsync(playerProductKey, true)
	end)
	if not okSave then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end
]]></string>
      </Properties>
    </Item>
  </Item>
