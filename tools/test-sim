#!/usr/bin/env bash
# tools/test-sim [--pending] [file ...]: the multi-server simulation suite (packages/framework/test/sim).
# Runs every sim *.spec.luau (also part of tools/test) plus the slow *.slow.luau soak tests.
# --pending also runs *.pending.luau (written against unmerged contract work; fails on stubs).
# Core-only: it tests the framework itself. A games repo's game boot specs (src/server/Boot.spec.luau)
# already run the sim through tools/test.
source "$(dirname "$0")/_common.sh"
help_if_asked "$0" "$@"

if is_games_repo; then
	echo "test-sim: framework suite; run it in the core repo (games' Boot specs run in tools/test)"
	exit 0
fi
lune run packages/framework/test/sim/run "$@"
