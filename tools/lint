#!/usr/bin/env bash
# tools/lint: selene + stylua --check over every Luau source (vendor, Packages, generated excluded),
# then tools/sync-projects --check (every *.project.json maps the module folders as generated),
# then the guardrails (tools/lune/guardrails.luau: modules, packages, numbers, remotes, purchases,
# special, theme; its --self-test proves each check still catches a planted violation).
#
# In a games repo (STUDWORK_PROJECT_ROOT set by its tools/ wrappers, docs/framework/games-repo.md)
# it lints the games repo's games/ with the CORE's selene/stylua configs, and the guardrails add
# the core-pin check (the roblox-core/ submodule is clean and its HEAD is a tag).
#
# In a single-game project (v1.5.0, docs/framework/single-game-project.md) it lints the project's
# own Luau: every top-level folder except studwork/ (the framework submodule), build/ and hidden
# folders (.cache/, .git/), with the core's configs; the guardrails check the studwork/ pin.
source "$(dirname "$0")/_common.sh"

if is_single_game; then
	# every top-level folder and Luau file of the project except the studwork/ submodule and the
	# tool folders .git/.cache/.worktrees (the same set the guardrails scan: Guard.ROOT_SKIPPED).
	# Arrays keep paths with spaces intact (bash 3.2).
	LINT_PATHS=()
	for d in * .[!.]* ..?*; do
		[ -e "$d" ] || continue
		case "$d" in
		"${CORE_DIR%%/*}" | .git | .cache | .worktrees | node_modules) continue ;;
		esac
		if [ -d "$d" ]; then
			LINT_PATHS+=("$d")
		else
			case "$d" in *.luau | *.lua) LINT_PATHS+=("$d") ;; esac
		fi
	done
	[ "${#LINT_PATHS[@]}" -gt 0 ] || die "nothing to lint in $PROJECT_ROOT"
	echo "== selene"
	# selene reads its std from the working directory: run it from the core with absolute paths
	ABS_PATHS=()
	for d in "${LINT_PATHS[@]}"; do ABS_PATHS+=("$PROJECT_ROOT/$d"); done
	(cd "$CORE_ROOT" && selene "${ABS_PATHS[@]}")
	echo "== stylua --check"
	stylua --config-path "$(core_path stylua.toml)" --check \
		-g '*.luau' -g '*.lua' -g '!**/server/Net.luau' -g '!**/client/Net.luau' -g '!**/Generated*.luau' \
		"${LINT_PATHS[@]}"
elif is_games_repo; then
	[ -d games ] || die "no games/ folder in $PROJECT_ROOT"
	echo "== selene"
	# selene reads its std (testkit.yml, based on roblox) from the working directory: run it from
	# the core with the games folder's absolute path
	(cd "$CORE_ROOT" && selene "$PROJECT_ROOT/games")
	echo "== stylua --check"
	# the core's stylua.toml; Blink outputs (module server/Net.luau, client/Net.luau) are generated
	stylua --config-path "$(core_path stylua.toml)" --check \
		-g '*.luau' -g '*.lua' -g '!**/server/Net.luau' -g '!**/client/Net.luau' -g '!**/Generated*.luau' \
		games
else
	PATHS="packages templates tools examples"
	if [ -d games ]; then PATHS="$PATHS games"; fi
	echo "== selene"
	selene $PATHS
	echo "== stylua --check"
	stylua --check $PATHS
fi
echo "== sync-projects --check"
lune_tool sync-projects --check
echo "== guardrails"
lune_tool guardrails --self-test
lune_tool guardrails
echo "lint: clean"
