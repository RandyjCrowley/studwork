#!/usr/bin/env bash
# tools/lint: selene + stylua --check over every Luau source (vendor, Packages, generated excluded),
# then tools/sync-projects --check (every *.project.json maps the module folders as generated),
# then the guardrails (tools/lune/guardrails.luau: modules, packages, numbers, remotes, purchases,
# special, theme; its --self-test proves each check still catches a planted violation).
#
# In a games repo (STUDWORK_PROJECT_ROOT set by its tools/ wrappers, docs/framework/games-repo.md)
# it lints the games repo's games/ with the CORE's selene/stylua configs, and the guardrails add
# the core-pin check (the roblox-core/ submodule is clean and its HEAD is a tag).
#
# In a single-game project (v1.5.0, docs/framework/single-game-project.md) it lints the project's
# own Luau: every top-level folder except studwork/ (the framework submodule), build/ and hidden
# folders (.cache/, .git/), with the core's configs; the guardrails check the studwork/ pin.
# (v1.6.0) In an adopted project, files listed in studwork-legacy.json skip selene and stylua (one
# `warning: [legacy] <path>: selene/stylua skipped` line each); the guardrails still apply the list.
# The file set is tools/_luau-files' (shared with tools/format).
# (v1.6.1) tools/lint --anchor-remote: also compare the legacy baseline anchor and the sticky
# adopted marker with the remote default branch's history (refs/remotes/origin/HEAD, else
# origin/main, else origin/master; local refs only: it never fetches). No remote default branch:
# a note, and it passes. A shallow clone fails (CI checks out with fetch-depth: 0). See
# docs/framework/guardrails.md.
ANCHOR_REMOTE=0
for arg in "$@"; do
	case "$arg" in
	--anchor-remote) ANCHOR_REMOTE=1 ;;
	--help | -h)
		# the header comment is the usage (the helper needs _common.sh, which comes later)
		awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
		exit 0
		;;
	*)
		echo "usage: tools/lint [--anchor-remote]" >&2
		exit 2
		;;
	esac
done
set --
source "$(dirname "$0")/_common.sh"

# shellcheck source=tools/_luau-files
source "$(dirname "$0")/_luau-files"
luau_file_set

echo "== selene"
if [ "${#SELENE_ARGS[@]}" -gt 0 ]; then
	if is_single_game || is_games_repo; then
		# selene reads its std (testkit.yml, based on roblox) from the working directory: run it
		# from the core with absolute paths
		(cd "$CORE_ROOT" && selene "${SELENE_ARGS[@]}")
	else
		selene "${SELENE_ARGS[@]}"
	fi
fi
echo "== stylua --check"
if [ "${#STYLUA_ARGS[@]}" -gt 0 ]; then
	STYLUA_OK=1
	if is_single_game || is_games_repo; then
		stylua --config-path "$STYLUA_CONFIG" --check "${STYLUA_GLOBS[@]}" "${STYLUA_ARGS[@]}" || STYLUA_OK=0
	else
		stylua --check "${STYLUA_ARGS[@]}" || STYLUA_OK=0
	fi
	if [ "$STYLUA_OK" -ne 1 ]; then
		echo "lint: formatting differs from StyLua: run tools/format to fix it, then lint again" >&2
		exit 1
	fi
fi
echo "== sync-projects --check"
lune_tool sync-projects --check
echo "== guardrails"
lune_tool guardrails --self-test
lune_tool guardrails
if [ "$ANCHOR_REMOTE" -eq 1 ]; then
	echo "== guardrails --anchor-remote"
	lune_tool guardrails --anchor-remote
fi
echo "lint: clean"
