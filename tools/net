#!/usr/bin/env bash
# tools/net: regenerate Blink networking code from every .blink IDL file
# (framework + modules: packages/{framework,kits}/**/*.blink; example modules and example games:
# examples/**; games: games/**/*.blink, including games/*/src/shared/net and game-local modules
# games/*/modules/**). In a games repo: its games/ only.
# Generated files are committed so builds don't need blink; never edit them by hand.
source "$(dirname "$0")/_common.sh"

if is_games_repo; then
	ROOTS="games"
else
	ROOTS="packages/framework packages/kits games examples"
fi
# shellcheck disable=SC2086
FILES="$(find $ROOTS -name '*.blink' -not -path '*/deps/*' 2>/dev/null | sort)"
[ -n "$FILES" ] || die "no .blink files found"
for f in $FILES; do
	echo "== blink $f"
	blink "$f"
done
