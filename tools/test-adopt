# (v1.6.0 dogfood r3) the three legacy fixtures (examples/legacy/, copied; never changed):
#   - init lists every old Luau source with the "style" pseudo-check, so after the one port the
#     playbook requires before the first commit (the ProcessReceipt assignment, simulated here by
#     renaming it) the first tools/lint and tools/typecheck pass (needs guardrails that know
#     "style"; older ones refuse it, then init doesn't write it and these checks are skipped)
#   - fixture a (a place file): --from-place records the extracted instances, --verify fails while
#     the place still holds them and passes that check after --strip-place . --extracted
#   - a stale $path in the project file fails --verify, naming it
FX="$CORE_ROOT/examples/legacy"
fixture() {
	local name="$1" dir="$WORK/fx-$1"
	mkdir -p "$dir"
	if [ "$name" = a ]; then
		cp "$FX/legacy-example-a/legacy-example-a.rbxlx" "$dir/"
		(cd "$dir" && "$ADOPT" --from-place legacy-example-a.rbxlx --out .) >"$LOGS/fx-a-from-place.log" 2>&1 ||
			fail "fixture a: --from-place | $(tail -3 "$LOGS/fx-a-from-place.log" | tr '\n' ' ')"
	else
		rsync -a --exclude saves --exclude FEATURES.md "$FX/legacy-example-$name/" "$dir/"
		(cd "$dir" && "$ADOPT" --audit .) >"$LOGS/fx-$name-audit.log" 2>&1 || fail "fixture $name: --audit"
	fi
	(cd "$dir" && tgit init -q && tgit add -A && tgit commit -q -m "the old game") >>"$LOGS/setup.log" 2>&1
	local before="$G"
	G="$dir"
	step "fixture $name: init" "$ADOPT" --init "$dir" --name "legacy-example-$name" --url "$WORK/studwork" --tag "$TAG" --no-install
	local leg="$dir/studwork-legacy.json" missing=""
	if [ "$STYLE_OK" -eq 1 ]; then
		local f
		while IFS= read -r f; do
			case "$f" in studwork/* | studwork-boot/* | modules/* | src/shared/Config/*) continue ;; esac
			tr -d ' \n' <"$leg" | grep -q "\"path\":\"$f\",\"checks\":\\[[^]]*\"style\"" || missing="$missing $f"
		done <<EOF
$(cd "$dir" && git ls-files -- '*.lua' '*.luau')
EOF
		check "fixture $name: every old Luau source lists \"style\"${missing:+ (missing:$missing)}" test -z "$missing"
		# the one port the playbook requires before the first commit (a never-downgraded finding)
		grep -rl 'MarketplaceService.ProcessReceipt = ' "$dir/src" 2>/dev/null | while IFS= read -r f; do
			sed -i.bak 's/MarketplaceService.ProcessReceipt = /local oldReceiptHandler = /' "$f" && rm -f "$f.bak"
		done
		step "fixture $name: first tools/lint" tools/lint
		step "fixture $name: first tools/typecheck" tools/typecheck
	else
		pass "fixture $name: SKIP the style checks (these guardrails don't know the style pseudo-check)"
	fi
	G="$before"
}
