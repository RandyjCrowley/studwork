# --modules choices: each minimal Config boots (tools/test runs the scaffold spec's sim boot) and
# typechecks; the audit's product ids land under placeholder names; an untracked audit report
# never blocks init and is named in the next steps; a ProcessReceipt file gets the exact advice
variant() {
	local mods="$1" dir="$WORK/mods-$(echo "$1" | tr ',' '-')"
	make_legacy "$dir"
	cat >"$dir/src/server/Purchases.server.luau" <<'EOF'
local MarketplaceService = game:GetService("MarketplaceService")

MarketplaceService.ProcessReceipt = function(receipt)
	if receipt.ProductId == 1234567 then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end
EOF
	sed -i.bak 's|"products": \[\], "passes": \[\]|"products": [ { "id": 1234567, "file": "src/server/Purchases.server.luau", "line": 4, "sold": [], "random": false } ], "passes": [ { "id": 7654321, "file": "src/server/Purchases.server.luau", "line": 4 } ]|' \
		"$dir/studwork-adopt-report.json"
	rm -f "$dir/studwork-adopt-report.json.bak"
	# the audit report stays untracked (written by tools/adopt --audit, not committed yet)
	(cd "$dir" && tgit add src && tgit rm -q --cached studwork-adopt-report.json && tgit commit -q -m "receipts") >>"$LOGS/setup.log" 2>&1
	local before="$G"
	G="$dir"
	step "init --modules $mods" "$ADOPT" --init "$dir" --name legacy-example-a --modules "$mods" --url "$WORK/studwork" --tag "$TAG" --no-install
	local log
	log="$(logof "init --modules $mods")"
	check "--modules $mods: an untracked audit report didn't block init" test -f "$dir/studwork.json"
	check "--modules $mods: next steps say to commit the audit report" grep -q "commit studwork-adopt-report\.\* with the adoption" "$log"
	check "--modules $mods: exact ProcessReceipt advice" grep -q \
		"port every product of src/server/Purchases.server.luau to ctx.shop.onProduct in modules/legacy-example-a/server/init.luau and delete the ProcessReceipt assignment before the first commit" "$log"
	check "--modules $mods: the audit's product + pass ids under placeholder names" sh -c \
		"grep -q 'Product1234567 = 1234567, -- TODO: name it' '$dir/src/shared/Config/init.luau' && grep -q 'Pass7654321 = 7654321, -- TODO: name it' '$dir/src/shared/Config/init.luau'"
	step "tools/test (--modules $mods)" tools/test
	check "--modules $mods: the scaffold spec's sim boot passed" grep -q "modules/legacy-example-a/module.spec.luau .*2 passed, 0 failed" \
		"$(logof "tools/test (--modules $mods)")"
	step "tools/typecheck (--modules $mods)" tools/typecheck
	step "tools/_studwork build (--modules $mods)" tools/_studwork build
	G="$before"
}
