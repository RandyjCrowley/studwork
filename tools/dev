#!/usr/bin/env bash
# tools/dev <game> [--print]
# Serve a game (games/<game>; examples/<game> in the core repo) to Roblox Studio with Rojo on the game's servePort (deploy.json) and print the
# Studio connect steps. --print only prints the steps and the command (doesn't start Rojo).
# In a single-game project (v1.5.0) the game is the root: tools/dev [--print].
source "$(dirname "$0")/_common.sh"
help_if_asked "$0" "$@"

usage() { die "usage: tools/dev <game> [--print]   (single-game project: tools/dev [--print])"; }
# v1.5.0 single-game project: the root is the game, so the name is optional
if is_single_game && { [ $# -eq 0 ] || [ "${1:-}" = "--print" ]; }; then
	set -- "$(single_game_name)" "$@"
fi
NAME="${1:-}"
[ -n "$NAME" ] || usage
PRINT_ONLY=0
[ "${2:-}" = "--print" ] && PRINT_ONLY=1
[ $# -le 2 ] || usage
[ $# -lt 2 ] || [ "$PRINT_ONLY" -eq 1 ] || usage

GAME_DIR="$(game_dir "$NAME")"
[ -n "$GAME_DIR" ] || die "no such game: $NAME (no games/$NAME/default.project.json)"
PROJECT="$GAME_DIR/default.project.json"
[ "$GAME_DIR" != "." ] || PROJECT="default.project.json"

PORT=""
if [ -f "$GAME_DIR/deploy.json" ]; then
	PORT="$(lune_tool json-get "$GAME_DIR/deploy.json" servePort 2>/dev/null || true)"
fi
if [ -z "$PORT" ]; then
	PORT="$(lune_tool json-get "$PROJECT" servePort 2>/dev/null || true)"
fi
[ -n "$PORT" ] || die "no servePort in $GAME_DIR/deploy.json or $PROJECT"

TEST_PLACE="$(lune_tool json-get "$GAME_DIR/deploy.json" test.placeId 2>/dev/null || echo 0)"
if [ "$TEST_PLACE" = "0" ] || [ -z "$TEST_PLACE" ]; then
	PLACE_HINT="a new Baseplate (the test place doesn't exist yet: deploy.json test.placeId is a placeholder)"
else
	PLACE_HINT="the TEST place $TEST_PLACE (never the live place), or a local Baseplate"
fi

cat <<STEPS
== tools/dev $NAME: rojo serve on port $PORT
Studio steps:
  1. Open Roblox Studio with $PLACE_HINT.
  2. Install the Rojo plugin once if needed (Studio > Plugins; version 7.7.x to match rokit.toml rojo).
  3. Plugins > Rojo > set the port to $PORT (address localhost) > Connect.
  4. Press Play to test. Edit code here; Rojo syncs on save. Ctrl+C here stops serving.
  Don't publish from Studio: use tools/publish $NAME --test (docs/framework/publishing.md).
STEPS

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
	echo "warning: port $PORT is already in use (another rojo serve?). tools/doctor shows which process."
fi

CMD="rojo serve $PROJECT --port $PORT"
if [ "$PRINT_ONLY" -eq 1 ]; then
	echo "command: $CMD"
	exit 0
fi
echo "== $CMD"
exec rojo serve "$PROJECT" --port "$PORT"
