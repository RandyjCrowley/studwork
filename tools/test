#!/usr/bin/env bash
# tools/test [path ...]: run every *.spec.luau (pure logic) under Lune.
# With no args: packages/, templates/, tools/ and examples/ (and games/ if present), then (core repo
# only) tools/test-games-repo, the end-to-end check of the games-repo mode (v1.4.0). In a games repo
# (docs/framework/games-repo.md): its games/. In a single-game project (v1.5.0): every top-level
# folder except studwork/ (and build/, hidden folders). With no args the core repo also runs
# tools/test-single-game after tools/test-games-repo, then (v1.6.0) tools/test-migration and
# tools/test-adopt. Exit 1 on any failure.
source "$(dirname "$0")/_common.sh"
help_if_asked "$0" "$@"

# (v1.7.1) Mirror the CI environment for the runner self-test: no $TMPDIR (its specs fall back to
# <cwd>/.cache) and a spec path with a doubled slash under a cwd that ends in "/" (Lune's
# process.cwd always does). macOS sets $TMPDIR, so without this a Mac run never saw what Linux CI saw.
# Runs on every invocation in the core repo, with or without path arguments.
if ! is_games_repo && ! is_single_game && [ -f "$PROJECT_ROOT/tools/lune/testkit/Runner.spec.luau" ]; then
	echo "== runner self-test (TMPDIR unset, trailing-slash cwd)"
	(cd "$PROJECT_ROOT/" && env -u TMPDIR lune run tools/lune/testkit/run \
		"$PROJECT_ROOT//tools/lune/testkit/Runner.spec.luau" \
		"$PROJECT_ROOT//tools/lune/testkit/pathutil.spec.luau") || exit 1
fi

if [ $# -eq 0 ] && ! is_games_repo; then
	lune_tool testkit/run
	echo "== tools/test-games-repo"
	"$CORE_ROOT/tools/test-games-repo"
	# v1.5.0: the single-game project mode end to end (docs/framework/single-game-project.md)
	echo "== tools/test-single-game"
	"$CORE_ROOT/tools/test-single-game"
	# v1.6.0: legacy imports against their sample old saves, then tools/adopt --init end to end
	echo "== tools/test-migration"
	"$CORE_ROOT/tools/test-migration"
	echo "== tools/test-adopt"
	exec "$CORE_ROOT/tools/test-adopt"
fi
lune_tool testkit/run "$@"
status=$?
# v1.6.0: a single-game project with legacy fixtures (tests/legacy/, modules/*/tests/legacy/) also
# runs its imports against them (docs/framework/adopting.md §3, tools/test-migration)
if [ $# -eq 0 ] && [ $status -eq 0 ] && is_single_game; then
	# (v1.6.0 dogfood) any one of the globs: `ls a b` fails when either is missing
	has_fixtures=0
	for f in tests/legacy/*.json modules/*/tests/legacy/*.json; do
		[ -f "$f" ] && has_fixtures=1 && break
	done
	if [ "$has_fixtures" = 1 ]; then
		echo "== tools/test-migration"
		"$CORE_ROOT/tools/test-migration" || exit 1
	fi
fi
exit $status
