#!/usr/bin/env bash
# tools/test [path ...]: run every *.spec.luau (pure logic) under Lune.
# With no args: packages/, templates/, tools/ and examples/ (and games/ if present). In a games repo
# (docs/framework/games-repo.md): its games/. Exit 1 on any failure.
source "$(dirname "$0")/_common.sh"

lune_tool testkit/run "$@"
