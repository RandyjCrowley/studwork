#!/usr/bin/env bash
# tools/typecheck [game]: strict type-check framework, kits, ui, the v1.2 shared files the kits still
# read (packages/core/shared), a game (default _sandbox) and the example modules (examples/) with luau-lsp,
# using Roblox definitions pinned to the luau-lsp version in rokit.toml and a Rojo sourcemap.
# Exit 1 on any type error.
source "$(dirname "$0")/_common.sh"

GAME="${1:-_sandbox}"
LUAU_LSP_TAG="1.70.1"
DEFS=".cache/globalTypes-$LUAU_LSP_TAG.d.luau"

mkdir -p .cache
if [ ! -f "$DEFS" ]; then
	echo "downloading Roblox type definitions (luau-lsp $LUAU_LSP_TAG)"
	curl -sfL -o "$DEFS" "https://raw.githubusercontent.com/JohnnyMorganz/luau-lsp/$LUAU_LSP_TAG/scripts/globalTypes.d.luau" \
		|| die "could not download definitions"
fi

[ -f "games/$GAME/default.project.json" ] || die "no such game: $GAME"
rojo sourcemap "games/$GAME/default.project.json" --absolute -o .cache/sourcemap.json >/dev/null

OUT="$(luau-lsp analyze --platform roblox \
	--sourcemap .cache/sourcemap.json \
	--defs "@roblox=$DEFS" \
	--defs "@testkit=tools/types/testkit.d.luau" \
	--ignore "**/Generated*.luau" \
	--ignore "**/deps/**" \
	packages/core/shared packages/framework/client packages/kits/compat \
	packages/framework/shared packages/framework/server packages/kits packages/ui \
	"games/$GAME/src" "games/$GAME/modules" 2>&1 \
	| grep -v '^\[INFO\]\|^\[WARN\]' || true)"

# Extra Rojo projects of the game (e.g. games/_sandbox/foundation-only.project.json): analyze
# their own src folder against their own sourcemap.
for EXTRA in games/$GAME/*.project.json; do
	[ -f "$EXTRA" ] || continue
	[ "$(basename "$EXTRA")" = "default.project.json" ] && continue
	SUB="games/$GAME/$(basename "$EXTRA" .project.json)"
	[ -d "$SUB" ] || continue
	rojo sourcemap "$EXTRA" --absolute -o .cache/sourcemap-extra.json >/dev/null
	OUT="$OUT$(luau-lsp analyze --platform roblox \
		--sourcemap .cache/sourcemap-extra.json \
		--defs "@roblox=$DEFS" \
		--defs "@testkit=tools/types/testkit.d.luau" \
		--ignore "**/Generated*.luau" \
		--ignore "**/deps/**" \
		"$SUB" 2>&1 \
		| grep -v '^\[INFO\]\|^\[WARN\]' || true)"
done

# The example modules (examples/modules/<m>), each against its fixture game's Rojo project
# (tests/fixture-game/default.project.json); specs are Lune-only (Phase 2).
for FIXTURE in examples/modules/*/tests/fixture-game/default.project.json; do
	[ -f "$FIXTURE" ] || continue
	MOD="$(dirname "$(dirname "$(dirname "$FIXTURE")")")"
	rojo sourcemap "$FIXTURE" --absolute -o .cache/sourcemap-example.json >/dev/null
	OUT="$OUT$(luau-lsp analyze --platform roblox \
		--sourcemap .cache/sourcemap-example.json \
		--defs "@roblox=$DEFS" \
		--defs "@testkit=tools/types/testkit.d.luau" \
		--ignore "**/Generated*.luau" \
		--ignore "**/deps/**" \
		--ignore "**/*.spec.luau" \
		"$MOD" 2>&1 \
		| grep -v '^\[INFO\]\|^\[WARN\]' || true)"
done

if [ -n "$OUT" ]; then
	echo "$OUT"
	COUNT="$(echo "$OUT" | grep -c 'Error\|Warning\|Deprecated' || true)"
	echo "typecheck: $COUNT problem(s)"
	exit 1
fi
echo "typecheck: clean"
