--!nocheck
-- tools/ is outside the harness index (packages, games, templates), so load by file path.
local Layout = require("tools/lune/Layout.luau")

local KITS = { "base", "collection", "economy", "engagement", "social" }

local function project(overrides: any?): any
	local rs = {
		Packages = { ["$path"] = "../../deps/Packages" },
		FrameworkClient = { ["$path"] = "../../packages/framework/client" },
		Framework = { ["$path"] = "../../packages/framework/shared" },
		-- v1.3.1 (R19): one folder per module (generated by tools/sync-projects)
		Modules = {
			["$className"] = "Folder",
			Items = {
				["$className"] = "Folder",
				module = { ["$path"] = "../../packages/kits/collection/Items/module.luau" },
			},
			Economy = {
				["$className"] = "Folder",
				module = { ["$path"] = "../../packages/kits/economy/Economy/module.luau" },
				client = { ["$path"] = "../../packages/kits/economy/Economy/client" },
			},
		},
	}
	local sss = {
		Framework = { ["$path"] = "../../packages/framework/server" },
		Modules = {
			["$className"] = "Folder",
			Items = { ["$path"] = "../../packages/kits/collection/Items/server" },
			Economy = { ["$path"] = "../../packages/kits/economy/Economy/server" },
			MyGame = { ["$path"] = "modules/my-game/server" },
		},
	}
	if overrides then
		overrides(rs, sss)
	end
	return {
		name = "g",
		tree = { ["$className"] = "DataModel", ReplicatedStorage = rs, ServerScriptService = sss },
	}
end

describe("Layout.normalize", function()
	it("collapses .. and . segments", function()
		expect(Layout.normalize("games/g/../../packages/framework/shared")).toBe("packages/framework/shared")
		expect(Layout.normalize("./a/./b/")).toBe("a/b")
		expect(Layout.normalize("games/g/tests/x/../../../../packages/ui")).toBe("packages/ui")
	end)
end)

describe("Layout.repoIssues", function()
	local function fs(paths: { string })
		local set = {}
		for _, p in paths do
			set[p] = true
		end
		return function(p)
			return set[p] == true
		end
	end
	local GOOD = {
		"packages/framework/shared",
		"packages/framework/server",
		"packages/framework/client",
		"packages/framework/shared/init.luau",
		"packages/kits/economy/Economy/module.luau",
	}
	local MODULES = { economy = { "Economy" } }

	it("is clean for the v1.3.1 layout (one folder per module)", function()
		expect(Layout.repoIssues(fs(GOOD), { "economy" }, MODULES)).toEqual({})
	end)

	it(
		"reports a leftover packages/core, a missing framework part, an old kit folder and an empty kit",
		function()
			local paths = table.clone(GOOD)
			table.insert(paths, "packages/core")
			table.insert(paths, "packages/kits/social/shared")
			table.remove(paths, 3) -- packages/framework/client
			local issues = Layout.repoIssues(fs(paths), { "economy", "social" }, { economy = { "Economy" } })
			expect(issues).toEqual({
				"packages/framework/client is missing",
				"packages/kits/social/shared is the pre-v1.3.1 kit layout (one folder per module: packages/kits/social/<Module>/)",
				"packages/kits/social has no module folder (<Module>/module.luau)",
				"packages/core still exists (removed in core v1.3.0; nothing may use it)",
			})
		end
	)

	it("reports no kits at all", function()
		expect(Layout.repoIssues(fs(GOOD), {})).toEqual({ "no kits under packages/kits" })
	end)
end)

describe("Layout.projectIssues", function()
	it("is clean for a generated game's mapping", function()
		expect(Layout.projectIssues(project(), "games/g", KITS)).toEqual({})
		expect(Layout.projectKits(project())).toEqual({ "Economy", "Items" })
	end)

	it("resolves $paths relative to the project's folder (examples fixture depth)", function()
		local p = project(function(rs, sss)
			rs.Framework["$path"] = "../../../../../packages/framework/shared"
			rs.FrameworkClient["$path"] = "../../../../../packages/framework/client"
			sss.Framework["$path"] = "../../../../../packages/framework/server"
			rs.Modules = nil
			sss.Modules = nil
		end)
		expect(Layout.projectIssues(p, "examples/modules/x/tests/fixture-game", KITS)).toEqual({})
	end)

	it("flags old layouts: packages/core, a Kits folder, unknown kits and misplaced module parts", function()
		local p = project(function(rs, sss)
			rs.Core = { ["$path"] = "../../packages/core/shared" }
			sss.Framework = nil
			sss.Kits = { Economy = { ["$path"] = "../../packages/kits/compat" } }
			sss.Modules.Economy["$path"] = "../../packages/kits/economy/server"
			rs.Modules.Quests = { module = { ["$path"] = "../../packages/kits/quests/Quests/module.luau" } }
		end)
		local issues = Layout.projectIssues(p, "games/g", KITS)
		table.sort(issues)
		expect(issues).toEqual({
			"ReplicatedStorage.Core maps packages/core/shared (removed in core v1.3.0)",
			"ReplicatedStorage.Modules.Quests: no kit 'quests' under packages/kits",
			"ServerScriptService.Framework is not mapped (want packages/framework/server)",
			"ServerScriptService.Kits.Economy maps packages/kits/compat (removed in core v1.3.0)",
			"ServerScriptService.Kits: the pre-v1.3.1 kit layout (removed; run tools/sync-projects)",
			"ServerScriptService.Modules.Economy maps packages/kits/economy/server (want packages/kits/economy/Economy/server)",
		})
	end)

	it("(v1.4.0) a games repo maps the core through its roblox-core/ submodule", function()
		local function into(node: any)
			for key, child in node do
				if key == "$path" and string.sub(child, 1, 6) == "../../" then
					node[key] = "../../roblox-core/" .. string.sub(child, 7)
				elseif type(child) == "table" then
					into(child)
				end
			end
		end
		local p = project()
		into(p)
		expect(Layout.projectIssues(p, "games/g", KITS, "roblox-core")).toEqual({})
		-- the core repo's own paths are wrong in a games repo
		local issues = Layout.projectIssues(project(), "games/g", KITS, "roblox-core")
		expect(#issues >= 3).toBe(true)
		expect(issues[1]).toBe(
			"ReplicatedStorage.Framework maps packages/framework/shared (want roblox-core/packages/framework/shared)"
		)
		local present = {
			["roblox-core/packages/framework/shared"] = true,
			["roblox-core/packages/framework/server"] = true,
			["roblox-core/packages/framework/client"] = true,
			["roblox-core/packages/framework/shared/init.luau"] = true,
			["packages/core"] = true, -- the games repo's own folders don't count
		}
		expect(Layout.repoIssues(function(path)
			return present[path] == true
		end, {}, nil, "roblox-core")).toEqual({ "no kits under roblox-core/packages/kits" })
	end)

	it("handles a project without a tree", function()
		expect(Layout.projectIssues({ name = "x" }, "games/x", KITS)).toEqual({ "no tree" })
	end)
end)
