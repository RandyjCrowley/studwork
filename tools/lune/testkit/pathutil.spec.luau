--!nocheck
-- tools/lune/testkit/pathutil.luau: the path helpers the harness and the temp-dir specs use.
local P = require("tools/lune/testkit/pathutil.luau")

describe("pathutil.normalize", function()
	it("collapses repeated slashes, '.' segments and a trailing slash", function()
		expect(P.normalize("/a//b/./c/")).toBe("/a/b/c")
		expect(P.normalize("a//b")).toBe("a/b")
	end)
	it("resolves '..' and keeps the root", function()
		expect(P.normalize("/a/b/../c")).toBe("/a/c")
		expect(P.normalize("/..")).toBe("/")
		expect(P.normalize("../x")).toBe("../x")
		expect(P.normalize("")).toBe(".")
	end)
end)

describe("pathutil.join", function()
	it("never doubles the slash, whatever the cwd looks like", function()
		expect(P.join("/repo/", ".cache")).toBe("/repo/.cache")
		expect(P.join("/repo", "/.cache")).toBe("/repo/.cache")
		expect(P.join("/repo//", "/.cache/", "x")).toBe("/repo/.cache/x")
	end)
end)

describe("pathutil.relativeTo", function()
	it("strips a cwd with or without a trailing slash", function()
		expect(P.relativeTo("/repo/tools/A.spec.luau", "/repo")).toBe("tools/A.spec.luau")
		expect(P.relativeTo("/repo/tools/A.spec.luau", "/repo/")).toBe("tools/A.spec.luau")
	end)
	it("handles doubled slashes in either argument (the CI shape)", function()
		expect(P.relativeTo("/repo//.cache/x/A.spec.luau", "/repo/")).toBe(".cache/x/A.spec.luau")
		expect(P.relativeTo("/repo/.cache/A.spec.luau", "/repo//")).toBe(".cache/A.spec.luau")
	end)
	it("is nil for a path outside the base, a sibling prefix or the base itself", function()
		expect(P.relativeTo("/other/A.spec.luau", "/repo")).toBeNil()
		expect(P.relativeTo("/repo-two/A.spec.luau", "/repo")).toBeNil()
		expect(P.relativeTo("/repo/", "/repo")).toBeNil()
	end)
	it("works against the root", function()
		expect(P.relativeTo("/a/b", "/")).toBe("a/b")
	end)
end)
