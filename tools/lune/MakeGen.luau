local SERVER_TEMPLATE = [=[
--!strict
--[[
	{{Name}} server part (module-api.md §3-§9), generated by tools/make-module. Everything comes
	from ctx: its config, its own save section, its declared dependencies, the shared ticker.
	init(ctx): no yielding, no calls into other modules. start(ctx): connect events, call deps.
]]

local {{Name}} = {}

local ctx: any = nil

function {{Name}}.init(c: any)
	ctx = c
end

function {{Name}}.start(c: any)
	c.lifecycle.onPlayerLoaded(function(player: Player)
		c.data.update(player, function(section: any)
			section.visits += c.config.pointsPerVisit
		end)
	end)
end

-- The public API (StudWork.use({{Name}}) on the server, ctx.deps[{{Name}}] in dependents). Frozen.
{{Name}}.api = {
	visits = function(player: Player): number
		return ctx.data.get(player).visits
	end,
}

return {{Name}}
]=]

local CLIENT_TEMPLATE = [=[
--!strict
--[[
	{{Name}} client part (module-api.md §9-§10), generated by tools/make-module. StudWork.use({{Name}})
	on the client returns { actions, state, ...api }; state() is this module's replicated slice
	{ data = { visits }, extra = { ... } }.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StudWork = require(ReplicatedStorage:WaitForChild("Framework"))

local Definition = require(script.Parent.module)

local {{Name}}Client = {}

{{Name}}Client.api = {
	visits = function(): number
		local slice = StudWork.use(Definition).state()
		return if slice.data then slice.data.visits or 0 else 0
	end,
}

return {{Name}}Client
]=]

