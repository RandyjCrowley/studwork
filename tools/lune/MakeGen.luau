	section is used. If it errors or returns a non-table, nothing is saved and the player gets the
	friendly kick with their data kept (module-api.md §6). Keep it pure: no services, no yields.
]]

return function(old: any): any
	local new = table.clone(old)
	-- TODO: reshape `new` for version {{to}} (and update data.default in module.luau to match)
	return new
end
]=]

