# https://editorconfig.org — matches stylua.toml (tabs, width 4, LF) for Luau.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{luau,lua}]
indent_style = tab
indent_size = 4
max_line_length = 110

[{tools/*,.githooks/*,*.sh}]
indent_style = tab
indent_size = 4

[*.blink]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.tmpl]
indent_style = tab
indent_size = 4
